# InfluxDB Configuration
INFLUXDB_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUXDB_ORG=Team_Plan_B
INFLUXDB_BUCKET=smart_pond_db
INFLUXDB_TOKEN=your_influxdb_token_here

# Weather Configuration (Open-Meteo — no API key needed)
WEATHER_LATITUDE=24.07
WEATHER_LONGITUDE=90.22
WEATHER_INTERVAL=15

# Email Alerts Configuration
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=alerts_recipient@gmail.com

# Pond & Device Identifiers
POND_ID=pond_01
DEVICE_ID=esp32_01

# Auto Feeding Configuration
FEED_INTERVAL_HOURS=9
FEED_DURATION_SEC=5
